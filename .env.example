# Copy to .env and fill in real values. .env is git-ignored.

# Postgres container credentials (read by docker-compose.yml)
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finance

# SQLAlchemy connection string used by the app (read by app/config.py).
# Must match the three values above. Host is localhost when the API runs
# on your machine against the compose-managed Postgres.
DATABASE_URL=postgresql+psycopg2://finance:change-me@localhost:5432/finance

# Auth. Generate the secret with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# LLM categorization (POST /categorize). Any OpenAI-compatible chat endpoint.
# Default is Google Gemini's free tier: key from https://aistudio.google.com/apikey
# Alternatives (same code, just change these three lines):
#   Groq:       https://api.groq.com/openai/v1        llama-3.3-70b-versatile
#   OpenRouter: https://openrouter.ai/api/v1          meta-llama/llama-3.3-70b-instruct:free
#   Anthropic:  https://api.anthropic.com/v1/         claude-haiku-4-5
# Leave LLM_API_KEY empty to run without categorization (endpoint returns 503).
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=25

# Reading receipt photos (POST /receipts/scan). Same key and base URL; this
# one must be a model that accepts images, and it gets a laxer timeout because
# a picture takes longer to think about. Groq and OpenRouter have vision
# models too; set the name here without touching the text model above.
LLM_VISION_MODEL=gemini-3.5-flash
LLM_VISION_TIMEOUT_SECONDS=45
# A reasoning model spends this budget thinking before it writes a character
# of the answer, and one that runs out mid-JSON returns nothing usable. The
# answer itself is about sixty tokens; the rest is head-room for thinking.
LLM_VISION_MAX_TOKENS=2000
# Largest photo the API will accept. The client downscales before uploading,
# so a normal receipt lands far below this. The photo is never stored.
RECEIPT_MAX_BYTES=4000000

# Android app (optional). Signing certificate SHA-256 fingerprint(s) of the
# APK, comma-separated; enables /.well-known/assetlinks.json so the app runs
# full screen. See android/README.md for the keytool command.
ANDROID_PACKAGE_NAME=ie.yarodev.pam
ANDROID_CERT_FINGERPRINTS=
