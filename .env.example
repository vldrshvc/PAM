# Copy to .env and fill in real values. .env is git-ignored.

# Postgres container credentials (read by docker-compose.yml)
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finance

# SQLAlchemy connection string used by the app (read by app/config.py).
# Must match the three values above. Host is localhost when the API runs
# on your machine against the compose-managed Postgres.
DATABASE_URL=postgresql+psycopg2://finance:change-me@localhost:5432/finance

# LLM categorization (POST /categorize). Any OpenAI-compatible chat endpoint.
# Default is Groq's free tier: get a key at https://console.groq.com/keys
# Leave LLM_API_KEY empty to run without categorization (endpoint returns 503).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=10
